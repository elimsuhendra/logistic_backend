{
  "apps": [
    {
      "name": "<%= fetch(:full_app_name) %>",
      "script": "<%= fetch(:deploy_to) %>/current/dist/index.js",
      "cwd": "<%= fetch(:deploy_to) %>/current/dist",
      "exec_interpreter": "/home/<%= fetch(:deploy_user) %>/.nvm/versions/node/<%= fetch(:nvm_node) %>/bin/node",
      "instances": "1",
      "exec_mode": "cluster",
      "watch": false,
        "env": {
          "NODE_ENV": "production",
          "APP_ENV": "<%= fetch(:stage) %>",
          "APP_NAME": ""<%= fetch(:application) %>"",
          "MONGO_DB_PROTOCOL": "mongodb+srv",
          "MONGO_DB_HOST": "",
          "MONGO_DB_NAME": "<%= fetch(:full_app_name) %>_db",
          "MONGO_DB_USERNAME": "",
          "MONGO_DB_PASSWORD": "",
          "MONGO_DB_PARAMS": "retryWrites=true&w=majority&maxPoolSize=30",
          "MONGO_DB_BG_PROTOCOL": "mongodb+srv",
          "MONGO_DB_BG_HOST": "",
          "MONGO_DB_BG_NAME": "<%= fetch(:full_app_name) %>_jobs_db",
          "MONGO_DB_BG_USERNAME": "",
          "MONGO_DB_BG_PASSWORD": "",
          "MONGO_DB_BG_PARAMS": "",
          "REDIS_HOST": "127.0.0.1",
          "PORT": "<%= fetch(:server_port) %>",
          "S3_BUCKET": "mtc-crm-assets",
          "S3_REGION": "ap-southeast-1",
          "AWS_ACCESS_KEY_ID": "",
          "AWS_SECRET_ACCESS_KEY": "",
          "SECRET1": "",
          "SECRET2": "",
          "MAIL_HOST": "",
          "MAIL_PORT": 587,
          "MAIL_USERNAME": "",
          "MAIL_PASSWORD": "",
          "EMAIL_SUPPORT": ""
        }
    }
  ]
}
