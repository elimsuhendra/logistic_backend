upstream <%= fetch(:full_app_name) %> {
  <% if fetch(:app_bind) %>
  server unix://<%= fetch(:app_bind) %>;
  <% elsif fetch(:server_port) %>
  server 127.0.0.1:<%= fetch(:server_port) %>;
  <% end %>
}

server {
  client_max_body_size 1G;

  large_client_header_buffers 8 16k;
  server_name <%= fetch(:server_name) %>;
  listen 80;

  root <%= fetch(:deploy_to) %>/current;

  try_files $uri/index.html $uri @<%= fetch(:full_app_name) %>;

  gzip on;
  gzip_disable "msie6";

  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_buffers 16 8k;
  gzip_http_version 1.1;
  gzip_min_length 256;
  gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/vnd.ms-fontobject application/x-font-ttf font/opentype image/svg+xml image/x-icon;

  location @<%= fetch(:full_app_name) %> {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_redirect off;
    # websocket
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 86400;
    
    if (!-f $request_filename) {
      proxy_pass http://<%= fetch(:full_app_name) %>;
      break;
    }
 }

  keepalive_timeout 60;
  error_page 500 502 503 504 /500.html;

  access_log  /var/log/nginx/<%= fetch(:full_app_name) %>.log;
  error_log  /var/log/nginx/<%= fetch(:full_app_name) %>.log;

}
