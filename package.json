{
  "name": "logistic_backend",
  "version": "1.3.2",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "serve": "node dist/index.js",
    "start": "nodemon --exec babel-node src/index.js",
    "build": "babel src -d dist --copy-files",
    "db:index": "babel-node ./src/migrations/indexing/index.js",
    "db:modification": "babel-node ./src/migrations/modification/index.js",
    "db:index:reset": "babel-node ./src/migrations/indexing/reset.js",
    "db:seed": "babel-node ./src/seeder/index.js",
    "db:seed:accounts": "babel-node ./src/seeder/index.js accounts",
    "db:seed:users": "babel-node ./src/seeder/index.js users",
    "import:company": "babel-node ./src/imports/importCompanies.js",
    "import:customer": "babel-node ./src/imports/importMtcCustomers.js",
    "import:postal": "babel-node ./src/imports/importPostal.js"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.2.6",
    "@graphql-tools/schema": "^8.1.2",
    "agenda": "^3.1.0",
    "agendash": "^4.0.0",
    "apollo-link-ws": "^1.0.19",
    "apollo-server-core": "^3.4.0",
    "apollo-server-express": "^3.1.2",
    "app-root-path": "^3.1.0",
    "aws-sdk": "^2.1023.0",
    "axios": "^0.27.2",
    "babel-plugin-import": "^1.13.3",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-polyfill": "^6.26.0",
    "base-64": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "cron-parser": "^4.1.0",
    "dotenv": "^10.0.0",
    "ejs": "^3.1.6",
    "email-templates": "^8.0.8",
    "exceljs": "^4.3.0",
    "express": "^4.17.1",
    "express-basic-auth": "^1.2.0",
    "get-graphql-schema": "^2.1.1",
    "glob": "^8.0.3",
    "graphql": "^14.5.8",
    "graphql-redis-subscriptions": "^1.3.1",
    "graphql-subscriptions": "^0.5.4",
    "graphql-tools": "^6.0.7",
    "graphql-type-json": "^0.3.2",
    "html-to-text": "^8.2.1",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.1",
    "mongodb": "^4.1.3",
    "node-fetch": "^2.3.0",
    "nodemailer": "^6.7.1",
    "nodemailer-postmark-transport": "^5.2.1",
    "pluralize": "^8.0.0",
    "pst-extractor": "^1.9.0",
    "redis": "^3.1.2",
    "request": "^2.88.2",
    "shortid": "^2.2.16",
    "subscriptions-transport-ws": "^0.9.19",
    "textract": "^2.5.0",
    "twilio": "^3.84.0",
    "validate.js": "^0.13.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-jest": "^27.3.0",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "babel-preset-env": "^1.7.0",
    "babel-preset-stage-3": "^6.24.1",
    "eslint": "^4.8.0",
    "eslint-config-airbnb": "^16.0.0",
    "eslint-config-airbnb-base": "^12.0.2",
    "eslint-plugin-import": "^2.7.0",
    "nodemon": "^2.0.13"
  },
  "nodemonConfig": {
    "ext": "js,json,env,gql,graphql",
    "watch": ".",
    "ignore": [
      ".git",
      "node_modules/**/node_modules"
    ]
