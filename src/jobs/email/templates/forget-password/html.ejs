<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
  <meta name="viewport" content="width=device-width" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>MTC | Forgot Password</title>
  <link rel="stylesheet" href="style.css" data-inline="data-inline">
</head>

<body itemscope itemtype="http://schema.org/EmailMessage">

  <table class="body-wrap">
    <tr>
      <td class="container" width="600">
        <div class="content">
          <table class="main" width="100%" cellpadding="0" cellspacing="0" itemprop="action" itemscope itemtype="http://schema.org/ConfirmAction">
            <%- include("../header.ejs") %>
            <tr>
              <td class="content-wrap">
                <meta itemprop="name" content="Forgot Password" />
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td class="content-block">
                      <h3 class="default-color">Hello, <%= fullName %></h3>
                    </td>
                  </tr>
                  <tr>
                    <td class="content-block">
                      <div>We've received a request to reset your password.</div>
                      <div>If you didn't make the request, please ignore this email.</div>
                      <br/>
                      <div>
                        <a href="<%= process.env.DASHBOARD_URL %>/reset-password?token=<%= token %>&email=<%= email %>" class="btn-primary"
                          itemprop="url">Click Here to Reset Password
                        </a>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td class="content-block">
                      <p>
                        Regards,<br />
                        MTC Team
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <%- include("../footer.ejs") %>
        </div>
      </td>
      <td></td>
    </tr>
  </table>

</body>

</html>